version: 1
environment:
  runtime: node
  runtime_version: "24"
  operating_system: linux
  image: "node@sha256:1111111111111111111111111111111111111111111111111111111111111111"
capture:
  host_operating_system: win32
  host_architecture: "x64"
  node_version: "24.15.0"
command:
  program: node
  arguments:
    - "reproduction.mjs"
  working_directory: .
files:
  - path: "calculate.mjs"
    role: subject
    encoding: utf8
    content: |-
      export function calculate(value) {
        return value + 1;
      }
    sha256: "4efedc1500baf98326c0ec905ce57d08952b86e985598f5dfbc7508262c72b7c"
  - path: "reproduction.mjs"
    role: reproduction
    encoding: utf8
    content: |-
      import { calculate } from './calculate.mjs';

      console.log('checking calculate(2)');
      const started = performance.now();
      const result = calculate(2);
      const elapsed = Math.round(performance.now() - started);
      if (result !== 4) {
        console.error(`Expected 4 from calculate(2) (${elapsed}ms)`);
        console.error(`    at ${import.meta.url}`);
        process.exitCode = 1;
      }
    sha256: "f07bff72ac2d5a3ec6edee69f068a8c08d2cf1c7b815a628ce11746ee7d46fca"
expect:
  exit_code: 1
  stdout:
    - mode: regex
      value: "checking calculate\\(\\d+\\)"
  stderr:
    - mode: regex
      normalize:
        - line_endings
        - ansi_escapes
        - trailing_whitespace
        - paths
        - node_version
        - node_internal_locations
        - process_ids
        - durations
      value: "Expected (?=4) from calculate"
    - mode: regex
      normalize:
        - line_endings
        - paths
      value: "at <project>/reproduction\\.mjs$"
limits:
  timeout_seconds: 60
  memory_mb: 512
  cpus: 1
  processes: 64
  output_bytes_per_stream: 1048576
redaction:
  enabled: true
  findings: []
